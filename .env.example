# CAI Demo 2 — environment configuration
# No API keys. Microsoft Entra ID only.

AZURE_SUBSCRIPTION_ID=<your-subscription-id>
AZURE_RESOURCE_GROUP=rgCAI

# Local development only: DefaultAzureCredential needs the tenant that owns the
# subscription above, because the Azure CLI may be signed in elsewhere.
AZURE_TENANT_ID=<your-tenant-id>

FOUNDRY_PROJECT_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com/api/projects/<your-project>
FOUNDRY_MODEL=gpt-5.6-terra

# Optional. Set only if FOUNDRY_MODEL cannot accept image input.
# Used for AI Call 1 (vision) while FOUNDRY_MODEL still handles AI Call 2.
FOUNDRY_VISION_MODEL=

DATABASE_PATH=/app/data/cai-demo2.db

DEMO_MODE=true
DEMO_EXTERNAL_DISPATCH=false
DEMO_AI_TIMEOUT_MS=20000
DEMO_FIXTURE_MODE=false

NEXT_PUBLIC_APP_TITLE=CAI Connected Maintenance Demo
